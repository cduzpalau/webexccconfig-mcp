# Webex token (required). Read only from the environment, never from the config file.
WEBEX_TOKEN=your_webex_access_token_here

# Fallbacks when no wxcc-ext.yaml is used (the config file takes precedence).
WEBEX_ORG_ID=your_webex_org_id_here
# Either a region code...
WXCC_REGION=us1
# ...or a bare base URL (no /v1 suffix):
# WEBEX_BASE_URL=https://api.wxcc-us1.cisco.com
# Webex API host for people, licenses and roles (default https://webexapis.com; FedRAMP overrides it):
# WEBEX_API_BASE_URL=https://webexapis.com

# Live smoke tests only: org ids allowed for `WXCC_LIVE=1 npm run test:live`.
# WXCC_SANDBOX_ORG_IDS=your_sandbox_org_id_here
