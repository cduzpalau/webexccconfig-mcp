{
  "name": "webexccconfig-mcp",
  "version": "2.0.0-dev",
  "description": "Stdio MCP server for Webex Contact Center configuration resources not covered by the official server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx --no-deprecation src/index.ts",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "fetch:spec": "tsx --no-deprecation scripts/fetch-spec.ts",
    "gen:registry": "tsx --no-deprecation scripts/gen-registry.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cduzpalau/webexccconfig-mcp.git"
  },
  "keywords": [
    "mcp",
    "webex",
    "contact-center"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "webexccconfig-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  }
}
